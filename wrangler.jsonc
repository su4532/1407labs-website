{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "1407labs-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    // Vite builds the site into ./dist (run `npm run build` first).
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the Worker before serving assets so the www -> apex redirect always applies.
    "run_worker_first": true
  },
  // Custom domains: Cloudflare creates the DNS records and SSL certs for these automatically.
  "routes": [
    { "pattern": "1407labs.com", "custom_domain": true },
    { "pattern": "www.1407labs.com", "custom_domain": true }
  ],
  "workers_dev": true
}
